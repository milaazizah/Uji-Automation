  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "pm.request.headers.upsert({ key: \"apikey\", value: pm.environment.get(\"anon_key\") });\r",
          "pm.request.headers.upsert({ key: \"Authorization\", value: \"Bearer \" + pm.environment.get(\"anon_key\") });\r",
          "pm.request.headers.upsert({ key: \"Content-Type\", value: \"application/json\" });\r",
          "pm.request.headers.upsert({ key: \"Prefer\", value: \"return=representation\" });"
        ],
        "type": "text/javascript"
      }
    }
