  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "F01 Login valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"Tepat 1 user ditemukan dengan role staff\", () => {\r\n    const data = pm.response.json();\r\n    pm.expect(data).to.be.an(\"array\").with.lengthOf(1);\r\n    pm.expect(data[0].role).to.eql(\"staff\");\r\n});\r\n\r\npm.test(\"Response time di bawah 2 detik\", () => {\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rest/v1/users?email=eq.{{staff_email}}&password=eq.{{staff_password}}&select=id,email,role",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "users"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "eq.{{staff_email}}"
                },
                {
                  "key": "password",
                  "value": "eq.{{staff_password}}"
                },
                {
                  "key": "select",
                  "value": "id,email,role"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "F02 Login Gagal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Password salah menghasilkan array kosong\", () => {\r\n    pm.expect(pm.response.json()).to.be.an(\"array\").that.is.empty;\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rest/v1/users?email=eq.{{staff_email}}&password=eq.TesSalah123&select=id,email,role",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "users"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "eq.{{staff_email}}"
                },
                {
                  "key": "password",
                  "value": "eq.TesSalah123"
                },
                {
                  "key": "select",
                  "value": "id,email,role"
                }
              ]
            }
          },
          "response": []
        }
      ]
