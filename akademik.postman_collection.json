              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Berhasil dibuat (201)\", () => pm.response.to.have.status(201));\r\n\r\npm.test(\"Data sesuai\", () => {\r\n    const d = pm.response.json();\r\n    pm.expect(d[0].id_mahasiswa).to.eql(pm.environment.get(\"test_id_mahasiswa\"));\r\n    pm.expect(d[0].nama).to.eql(\"Mahasiswa Uji\");\r\n});"
                ]
