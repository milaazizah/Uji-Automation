    {
      "name": "03 Keamanan",
      "item": [
        {
          "name": "S03-1 Ubah nilai tanpa login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"S03: anon tidak boleh mengubah nilai\", () => {\r\n    const ditolak = [401, 403].includes(pm.response.code);\r\n    const tidakBerubah = pm.response.code === 200 && pm.response.json().length === 0;\r\n    pm.expect(ditolak || tidakBerubah, \"nilai berhasil diubah tanpa login\").to.be.true;\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"nilai_akhir\": 100 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/rest/v1/nilai?id_mahasiswa=eq.{{mhs_id}}&id_jadwal=eq.{{id_jadwal}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "nilai"
              ],
              "query": [
                {
                  "key": "id_mahasiswa",
                  "value": "eq.{{mhs_id}}"
                },
                {
                  "key": "id_jadwal",
                  "value": "eq.{{id_jadwal}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "S01- table user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();\r\n\r\npm.test(\"S01: Tabel users tidak bisa dibaca tanpa login\", () => {\r\n    const ditolak = [401, 403].includes(pm.response.code);\r\n    const kosong = Array.isArray(d) && d.length === 0;\r\n    pm.expect(ditolak || kosong, \"data users bisa dibaca siapa saja\").to.be.true;\r\n});\r\n\r\npm.test(\"S02: Kolom password tidak terbaca\", () => {\r\n    const bocor = Array.isArray(d) && d.some(u => \"password\" in u);\r\n    pm.expect(bocor, \"kolom password terbaca lewat API\").to.be.false;\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
